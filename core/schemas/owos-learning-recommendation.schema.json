{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owos.ai/schemas/owos-learning-recommendation.schema.json",
  "title": "OWOS next-best-learning recommendation",
  "type": "object",
  "required": [
    "schema_version",
    "recommendation_id",
    "learner_id",
    "lane",
    "learning_item",
    "reason",
    "evidence",
    "competencies",
    "prerequisites",
    "ranking_method",
    "confidence",
    "freshness",
    "learner_controls"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "recommendation_id": {"type": "string", "pattern": "^owos:recommendation:"},
    "learner_id": {"type": "string", "pattern": "^learner:"},
    "lane": {"enum": ["deepen", "reskill", "cross-skill"]},
    "learning_item": {
      "type": "object",
      "required": ["id", "title", "version", "domain"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "version": {"type": "string"},
        "domain": {
          "enum": [
            "drinking-water",
            "wastewater",
            "stormwater",
            "one-water",
            "data",
            "leadership",
            "artificial-intelligence"
          ]
        }
      },
      "additionalProperties": false
    },
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "competencies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prerequisites": {
      "type": "object",
      "required": ["satisfied", "missing"],
      "properties": {
        "satisfied": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "ranking_method": {"enum": ["rules", "rules-plus-ai"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "freshness": {"type": "string", "format": "date"},
    "learner_controls": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["accept", "dismiss", "snooze", "correct-profile"]}
    }
  },
  "additionalProperties": false
}
