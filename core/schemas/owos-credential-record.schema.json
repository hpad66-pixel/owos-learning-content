{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owos.ai/schemas/owos-credential-record.schema.json",
  "title": "OWOS credential record",
  "type": "object",
  "required": [
    "schema_version",
    "credential_id",
    "state",
    "learner_id",
    "learner_display_name",
    "offering",
    "completion",
    "credit",
    "issuer",
    "verification",
    "issuance_gates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "credential_id": {"type": "string", "pattern": "^owos:credential:"},
    "state": {
      "enum": ["evidence_pending", "eligible", "issued", "expired", "superseded", "revoked"]
    },
    "learner_id": {"type": "string", "pattern": "^learner:"},
    "learner_display_name": {"type": "string", "minLength": 1},
    "offering": {
      "type": "object",
      "required": ["id", "title", "version", "source_commit", "package_checksum"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "version": {"type": "string"},
        "source_commit": {"type": "string"},
        "package_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "completion": {
      "type": "object",
      "required": ["completed_at", "passing_rule", "evidence_event_ids"],
      "properties": {
        "completed_at": {"type": "string", "format": "date-time"},
        "passing_rule": {"type": "string"},
        "evidence_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^urn:uuid:"}
        }
      },
      "additionalProperties": true
    },
    "credit": {
      "type": "object",
      "required": ["claim_state", "unit", "amount", "profile_id"],
      "properties": {
        "claim_state": {"enum": ["disabled", "approved"]},
        "unit": {"type": ["string", "null"]},
        "amount": {"type": ["number", "null"], "minimum": 0},
        "profile_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "issuer": {
      "type": "object",
      "required": ["organization", "signer", "signature_state"],
      "properties": {
        "organization": {"type": "string"},
        "signer": {"type": "string"},
        "signature_state": {"enum": ["specimen", "pending", "signed"]}
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["url", "status_record"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "status_record": {"type": "string"}
      },
      "additionalProperties": true
    },
    "issuance_gates": {
      "type": "object",
      "required": [
        "offering",
        "content_release",
        "identity",
        "participation",
        "assessment",
        "evaluation",
        "accreditor",
        "issuer_and_status"
      ],
      "additionalProperties": {
        "enum": ["passed", "pending", "not_applicable", "blocked"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "credit": {
            "properties": {"claim_state": {"const": "approved"}},
            "required": ["claim_state"]
          }
        }
      },
      "then": {
        "properties": {
          "credit": {
            "properties": {
              "unit": {"type": "string", "minLength": 1},
              "amount": {"type": "number", "exclusiveMinimum": 0},
              "profile_id": {"type": "string", "minLength": 1}
            }
          },
          "issuance_gates": {
            "properties": {"accreditor": {"const": "passed"}}
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
