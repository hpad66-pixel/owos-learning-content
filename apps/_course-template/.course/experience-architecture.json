    "factory_pattern_share": 0.4
  },
  "lessons": {
    "module-01-example.html": {
      "archetype": "replace-with-learning-archetype",
      "signature_mechanism": "replace-with-subject-specific-mechanism",
      "opening": "replace-with-opening-pattern",
      "work_product_mode": "replace-with-work-product",
      "evidence": {
        "brief": "curriculum/design-briefs/module-01-example.md",
        "qa": "qa/module-01-example-quality-control-report.md"
      }
    }
  }
}
